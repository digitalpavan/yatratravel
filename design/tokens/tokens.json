{
  "$description": "Yatra Travels design tokens. Mirrors tokens.css. Values in px unless noted.",
  "color": {
    "brand": {
      "navy-900": { "value": "#101C2C", "note": "Primary navy" },
      "navy-700": { "value": "#263548", "note": "Secondary navy" },
      "gold-500": { "value": "#C9A45C", "note": "Premium gold. Fills and icons; text only on navy (7.31:1)" },
      "gold-300": { "value": "#E2C88F", "note": "Gold hover" },
      "gold-700": { "value": "#7D5F26", "note": "Accessible gold for text on light backgrounds (5.45:1 on warm white)" },
      "warm-50": { "value": "#F7F5F0", "note": "Warm white page background" },
      "white": { "value": "#FFFFFF" }
    },
    "neutral": {
      "slate-700": { "value": "#334155", "note": "Body text" },
      "slate-500": { "value": "#64748B", "note": "Muted text on white surfaces only (4.76:1)" },
      "slate-550": { "value": "#5F6B7D", "note": "Muted text on warm white (4.96:1)" },
      "slate-400": { "value": "#8392A6", "note": "Form control borders (3.17:1)" },
      "slate-300": { "value": "#AAB6C6", "note": "Muted text on navy (8.34:1)" },
      "sand-200": { "value": "#E7E2D7", "note": "Decorative borders" },
      "sand-100": { "value": "#EFEBE3", "note": "Skeletons, subtle fills" }
    },
    "status": {
      "green-600": { "value": "#168C58", "note": "Success icons/borders" },
      "green-700": { "value": "#147A4D", "note": "Success text, or solid fill with white text" },
      "green-50": { "value": "#E8F4EE" },
      "red-600": { "value": "#DC2626", "note": "Error icons/borders; text on white" },
      "red-700": { "value": "#C62828", "note": "Error text on warm white" },
      "red-50": { "value": "#FDECEC" },
      "whatsapp": { "value": "#1F7A4A", "note": "WhatsApp button fill with white text" }
    }
  },
  "font": {
    "family": {
      "display": "Manrope, ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, Arial, sans-serif",
      "body": "Inter, ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, Arial, sans-serif"
    },
    "weight": { "regular": 400, "medium": 500, "semibold": 600, "bold": 700, "extrabold": 800 },
    "usage": {
      "headline": "display / 800 (h1-h2), 700 (h3-h4)",
      "body": "body / 400",
      "navigation": "body / 500",
      "button": "body / 600",
      "price": "display / 800, tabular numerals"
    },
    "size": {
      "display": "clamp(40px → 72px)",
      "h1": "clamp(34px → 56px)",
      "h2": "clamp(28px → 44px)",
      "h3": "clamp(22px → 28px)",
      "h4": 20, "lg": 18, "md": 16, "sm": 14, "xs": 12,
      "price": "clamp(24px → 32px)"
    },
    "lineHeight": { "tight": 1.15, "snug": 1.3, "normal": 1.6 }
  },
  "space": { "1": 4, "2": 8, "3": 12, "4": 16, "5": 24, "6": 32, "7": 48, "8": 64, "9": 96, "10": 128 },
  "radius": { "sm": 6, "md": 10, "lg": 16, "xl": 24, "pill": 999 },
  "shadow": {
    "sm": "0 1px 2px rgba(16,28,44,.06), 0 1px 3px rgba(16,28,44,.08)",
    "md": "0 4px 12px rgba(16,28,44,.08), 0 2px 4px rgba(16,28,44,.05)",
    "lg": "0 16px 40px rgba(16,28,44,.14), 0 4px 10px rgba(16,28,44,.06)"
  },
  "layout": {
    "containerMax": 1320,
    "containerNarrow": 760,
    "gutter": "clamp(16px → 32px)",
    "headerHeight": 72,
    "breakpoints": { "sm": 640, "md": 768, "lg": 1024, "xl": 1280 }
  },
  "motion": { "fast": "120ms", "base": "200ms", "slow": "320ms", "ease": "cubic-bezier(.2,.8,.2,1)" }
}

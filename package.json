{
  "name": "yatra-travels",
  "version": "0.1.0",
  "private": true,
  "description": "Yatra Travels: Tirupati and Tirumala pilgrimage tours website",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "images": "node scripts/build-images.mjs",
    "images:check": "node scripts/build-images.mjs --check",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/db.mjs migrate",
    "db:seed": "node --env-file-if-exists=.env.local scripts/db.mjs seed",
    "admin:create": "node --env-file-if-exists=.env.local scripts/db.mjs create-admin",
    "test:rls": "node supabase/tests/rls.test.mjs"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.11",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "ffmpeg-static": "^5.2.0",
    "pg": "^8.23.1",
    "sharp": "^0.33.5",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "@vercel/speed-insights": "^2.0.0",
    "lucide-react": "^1.61.0",
    "marked": "^18.1.1",
    "motion": "^14.6.0",
    "next": "^16.4.3",
    "pdf-lib": "1.17.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  }
}

# Copy to .env.local and fill in. Never commit .env.local.

# Public URL of the site (canonical links, sitemap, structured data, auth email links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only. Full database access: never expose to the browser.
SUPABASE_SECRET_KEY=
# Only needed for `npm run db:migrate` / `db:seed` / `admin:create` (Project Settings → Database → connection string)
SUPABASE_DB_URL=
# Signs private booking-confirmation links. Generate with: openssl rand -hex 32
BOOKING_TOKEN_SECRET=
# The business's WhatsApp number for click-to-chat links: country code + number, digits only (e.g. 919876543210).
# Overrides the number saved in /admin/content.
WHATSAPP_BUSINESS_NUMBER=

# Optional: Google Search Console HTML-tag verification code (the content="…" value only).
GOOGLE_SITE_VERIFICATION=
# Optional: set to 1 after enabling Speed Insights in the Vercel project, to collect real-user Core Web Vitals.
NEXT_PUBLIC_SPEED_INSIGHTS=
# Optional: direct link to an .mp3 for the website's background music. Defaults to public/audio/background-music.mp3.
NEXT_PUBLIC_BACKGROUND_MUSIC_URL=

# Optional: automatic booking emails through Resend (https://resend.com). Leave RESEND_API_KEY empty to send none.
RESEND_API_KEY=
# Sender address on a domain verified in Resend, e.g. Yatra Travels <bookings@yourdomain.in>
NOTIFY_EMAIL_FROM=
# Who receives new-booking alerts (comma-separated). Defaults to the contact email in /admin/content.
OWNER_NOTIFY_EMAIL=

# Optional: set to 1 to run without Supabase, using built-in sample data.
# YATRA_DEMO_DATA=1
